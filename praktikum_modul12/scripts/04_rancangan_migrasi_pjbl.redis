# VERIFIKASI
HGETALL wilayah:1
HGETALL station:S01
HGETALL reading:R001
ZRANGE station:S01:readings 0 -1 WITHSCORES

-- ==========================================
-- PjBL SISTEM INFORMASI CUACA BAGI PETANI
-- LUA SCRIPT JOIN DATA CUACA DAN STASIUN
-- ==========================================

-- KEYS[1] = indeks pembacaan stasiun
-- ARGV[1] = batas waktu awal
-- ARGV[2] = key data stasiun

local readings = redis.call(
    "ZRANGEBYSCORE",
    KEYS[1],
    ARGV[1],
    "+inf"
)

local station_name = redis.call(
    "HGET",
    ARGV[2],
    "nama_stasiun"
)

local result = {}

for _, id in ipairs(readings) do

    local data = redis.call(
        "HGETALL",
        "reading:" .. id
    )

    local record = {}

    for i = 1, #data, 2 do
        record[data[i]] = data[i + 1]
    end

    table.insert(
        result,
        {
            reading_id = id,
            nama_stasiun = station_name or "-",
            suhu = record["suhu"] or "-",
            kelembapan = record["kelembapan"] or "-",
            curah_hujan = record["curah_hujan"] or "-",
            waktu = record["waktu"] or "-"
        }
    )

end
return cjson.encode(result)

-----------------------------
# ACL USER PETANI
# HAK AKSES: MEMBACA DATA
--------------------------------
ACL SETUSER petani_user reset on >PasswordPetani123 %R~station:* %R~reading:* -@all +zrangebyscore +zrevrangebyscore +hget +hmget +hgetall

# MELIHAT INFORMASI USER
ACL GETUSER petani_user

-----------------------------------------------
# ACL USER OPERATOR STASIUN
# HAK AKSES: MEMBACA DAN MEMPERBARUI DATA
-----------------------------------------------
ACL SETUSER operator_stasiun reset on >PasswordOperator456 ~station:* ~reading:* -@all +hset +zadd +hget +hmget +hgetall +zrangebyscore +expire

# MELIHAT INFORMASI USER
ACL GETUSER operator_stasiun

# PETANI MEMBACA DATA STASIUN
HGETALL station:S01

# PETANI MEMBACA DATA CUACA
HGETALL reading:R001

# PETANI MELIHAT INDEKS PEMBACAAN
ZRANGE station:S01:readings 0 -1

-----------------------------
# PENGUJIAN AKUN OPERATOR
-----------------------------
# OPERATOR MEMBACA DATA
HGETALL station:S01

# OPERATOR MEMPERBARUI DATA
HSET reading:R001 suhu 29.5

# OPERATOR MENAMBAHKAN INDEKS
ZADD station:S01:readings 1793865600 R005

# MEMERIKSA HASIL PERUBAHAN
HGETALL reading:R001

---------------------------
# VERIFIKASI ACL
----------------------------
ACL GETUSER petani_user
ACL GETUSER operator_stasiun
